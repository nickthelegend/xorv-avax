{
  "name": "xorv-avax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "abi": "node scripts/gen-abi.mjs",
    "build:contracts": "cd contracts && forge build && cd .. && node scripts/gen-abi.mjs",
    "test:contracts": "cd contracts && forge test",
    "test:sdk": "node --test packages/sdk/test/*.test.ts",
    "test:eerc": "node --test --test-concurrency=1 packages/eerc/test/*.test.ts",
    "test:gateway": "node --test packages/gateway/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "circuits": "node scripts/fetch-eerc-circuits.mjs",
    "gateway": "node packages/gateway/src/server.ts",
    "node": "node packages/node/src/cli.ts",
    "mcp": "node packages/mcp/src/main.ts",
    "test:local": "bash scripts/test-local.sh",
    "xorv": "node packages/cli/src/main.ts",
    "xorv-node": "node packages/node/src/cli.ts",
    "test:fuji": "node --test packages/sdk/test/fuji.test.ts",
    "xorv-mcp": "node packages/mcp/src/main.ts",
    "mcp:call": "node packages/mcp/src/call.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "viem": "2.37.6",
    "@xorv/eerc": "workspace:*",
    "@xorv/sdk": "workspace:*",
    "@xorv/cli": "workspace:*"
  }
}
