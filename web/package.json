{
  "name": "@xorv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5390 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:qa": "VITE_XORV_QA=1 vite build --outDir dist-qa",
    "preview": "vite preview --host 127.0.0.1 --port 5390 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "shots": "node scripts/shots.mjs",
    "qa:flow": "node scripts/qa-flow.mjs"
  },
  "dependencies": {
    "@xorv/sdk": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "viem": "2.37.6"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.5"
  }
}
